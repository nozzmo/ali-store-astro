# Llaves de la Store API de Ali (Ali → Integraciones → Store API).
# Publicable: va al navegador para el carrito y el checkout. Obligatoria.
ALI_PUBLISHABLE_KEY=ali_pk_test_reemplazame
# Secreta: sólo la usa el servidor para leer el catálogo (recomendada en producción:
# Ali cuenta el límite por comprador gracias al header Ali-Buyer-IP). Nunca la publiques.
ALI_SECRET_KEY=

# Opcionales
# ALI_API_URL=https://soyali.com/api/store/v1
# SITE_URL=https://mitienda.com          # para canonical, sitemap y Open Graph
# ALI_BUSINESS_SLUG=mi-negocio           # sólo si querés forzar el slug de data-ali-business
# ALI_CACHE_SECONDS=60                    # cuánto se cachea el catálogo
