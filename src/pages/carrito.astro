---
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"
import { noStore } from "../lib/http"
import { guard, loadShell } from "../lib/site"

const shell = await guard(Astro, () => loadShell(Astro))
if (shell instanceof Response) return shell
// Modo catálogo: no hay carrito ni checkout.
if (shell.catalogOnly) return Astro.redirect("/", 302)
noStore(Astro)
const { store } = shell
---
<Base shell={shell} title="Tu carrito" path="/carrito" noindex>
  <section class="tight">
    <div class="wrap">
      <h1>Tu carrito</h1>
      <div class="two-col" data-cart-app>
        <div>
          <div data-issues></div>
          <div class="cart-lines" data-lines aria-live="polite">
            <div class="cart-line"><div class="thumb skeleton"></div><div><div class="skeleton" style="height:18px;width:60%"></div><div class="skeleton" style="height:14px;width:35%;margin-top:10px"></div></div><span></span></div>
          </div>
          <p class="notice warn" data-error hidden role="alert"></p>
          <a class="text-link" href="/" style="margin-top:24px"><Icon name="back" /> Seguir comprando</a>
        </div>
        <aside>
          <div class="summary" data-summary>
            <h2>Resumen</h2>
            <div class="row"><span>Subtotal</span><span data-subtotal>—</span></div>
            <div class="row"><span>Envío</span><span class="muted" data-shipping data-default={store.fulfillment.delivery.enabled ? "Se calcula en el siguiente paso" : "Retiro en tienda"}>{store.fulfillment.delivery.enabled ? "Se calcula en el siguiente paso" : "Retiro en tienda"}</span></div>
            <div class="row total"><span>Total</span><span data-total>—</span></div>
            <a class="btn block" href="/checkout" data-go aria-disabled="true" style="margin-top:16px">Continuar al pago</a>
            <p class="note"><Icon name="lock" /> Los precios se confirman con la tienda antes de pagar.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { dismissIssue, getCart, problemMessage, removeVariant, setQuantity, esc, visibleIssues, type Cart, type Problem } from "../scripts/store"
  import { BLOCKING_ISSUES, issueMessage, money } from "../lib/format"

  const app = document.querySelector<HTMLElement>("[data-cart-app]")!
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => app.querySelector<T>(s)!
  const linesEl = $("[data-lines]"), issuesEl = $("[data-issues]"), errorEl = $("[data-error]"), go = $<HTMLAnchorElement>("[data-go]")
  const photo = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="10" r="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="m4 17 5-4.5 3.5 3 3-2.5L20 17"/></svg>'
  let cart: Cart | null = null

  // Todo lo que se muestra sale del carrito que devuelve Ali; acá no se suma nada.
  function renderIssues(c: Cart) {
    const issues = visibleIssues(c)
    issuesEl.innerHTML = issues.map((i) => {
      const blocking = BLOCKING_ISSUES.includes(i.code)
      const remove = blocking && i.line?.variant_id ? `<button class="btn ghost small" type="button" data-issue-remove="${esc(i.line.variant_id)}">Quitar del carrito</button>` : ""
      return `<div class="notice warn issue"><span>${esc(issueMessage(i, c.totals.currency))}${blocking ? " Quitalo para poder pagar." : ""}</span>${remove}</div>`
    }).join("")
    return issues.some((i) => BLOCKING_ISSUES.includes(i.code))
  }

  function render() {
    const blocked = cart ? renderIssues(cart) : false
    const empty = !cart || cart.lines.length === 0
    go.setAttribute("aria-disabled", String(empty || blocked))
    go.toggleAttribute("data-disabled", empty || blocked)
    go.textContent = blocked ? "Quitá los productos no disponibles" : "Continuar al pago"
    if (empty) {
      linesEl.innerHTML = `<div class="catalog-empty" style="margin-top:8px"><h2>Tu carrito está vacío</h2><p class="muted">Agregá productos desde el catálogo.</p><a class="btn" href="/">Ver productos</a></div>`
      linesEl.classList.remove("cart-lines")
      $("[data-subtotal]").textContent = money(0, cart?.totals.currency)
      $("[data-total]").textContent = money(0, cart?.totals.currency)
      return
    }
    const c = cart!
    linesEl.classList.add("cart-lines")
    linesEl.innerHTML = c.lines.map((l) => `
      <div class="cart-line" data-line="${esc(l.variant_id)}" data-qty="${l.quantity}">
        <div class="thumb">${l.image_url ? `<img src="${esc(l.image_url)}" alt="" loading="lazy">` : photo}</div>
        <div>
          <h3>${esc(l.product_name)}</h3>
          <div class="meta">${[l.variant_name && l.variant_name !== l.product_name ? esc(l.variant_name) : "", l.available ? "" : "<strong>Agotado</strong>"].filter(Boolean).join(" · ")}</div>
          <div class="controls">
            <div class="qty small" role="group" aria-label="Cantidad de ${esc(l.product_name)}">
              <button type="button" data-dec aria-label="Quitar uno" ${l.quantity <= 1 ? "disabled" : ""}>−</button>
              <input value="${l.quantity}" aria-label="Cantidad" inputmode="numeric" data-qty-input>
              <button type="button" data-inc aria-label="Agregar uno" ${l.stock !== null && l.quantity >= l.stock ? "disabled" : ""}>+</button>
            </div>
            <button class="link-btn" type="button" data-remove>Quitar</button>
          </div>
        </div>
        <div class="unit">${esc(l.line_total_display ?? money(l.unit_price, l.currency))}<small>${l.line_total_display ? `${esc(money(l.unit_price, l.currency))} c/u` : `c/u · ${l.quantity} ${l.quantity === 1 ? "unidad" : "unidades"}`}</small></div>
      </div>`).join("")
    $("[data-subtotal]").textContent = money(c.totals.subtotal, c.totals.currency)
    const shipping = $("[data-shipping]")
    shipping.textContent = c.fulfillment_mode === "delivery" && c.shipping_status === "priced" ? money(c.totals.shipping, c.totals.currency) : shipping.dataset.default ?? ""
    $("[data-total]").textContent = money(c.totals.total, c.totals.currency)
  }

  function fail(problem: unknown) {
    errorEl.textContent = problemMessage(problem as Problem)
    errorEl.hidden = false
  }

  async function update(variantId: string, quantity: number) {
    errorEl.hidden = true
    app.querySelector(".summary")?.classList.add("updating")
    try {
      cart = await setQuantity(variantId, quantity)
      render()
    } catch (problem) {
      fail(problem)
    } finally {
      app.querySelector(".summary")?.classList.remove("updating")
    }
  }

  linesEl.addEventListener("click", (event) => {
    const t = event.target as HTMLElement
    const row = t.closest<HTMLElement>("[data-line]")
    if (!row) return
    const current = Number(row.dataset.qty)
    if (t.closest("[data-inc]")) update(row.dataset.line!, current + 1)
    else if (t.closest("[data-dec]")) update(row.dataset.line!, current - 1)
    else if (t.closest("[data-remove]")) update(row.dataset.line!, 0)
  })
  linesEl.addEventListener("change", (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-qty-input]")
    const row = input?.closest<HTMLElement>("[data-line]")
    if (input && row) update(row.dataset.line!, Math.max(0, Math.min(999, Math.floor(Number(input.value) || 0))))
  })
  issuesEl.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-issue-remove]")
    if (!button) return
    const variantId = button.dataset.issueRemove!
    button.classList.add("loading")
    errorEl.hidden = true
    try {
      dismissIssue(variantId)
      cart = await removeVariant(variantId)
      render()
    } catch (problem) {
      fail(problem)
      button.classList.remove("loading")
    }
  })
  go.addEventListener("click", (event) => { if (go.hasAttribute("data-disabled")) event.preventDefault() })

  getCart().then((c) => { cart = c; render() }).catch((problem) => { cart = null; render(); fail(problem) })
</script>
