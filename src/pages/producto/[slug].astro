---
import Base from "../../layouts/Base.astro"
import Icon from "../../components/Icon.astro"
import ProductCard from "../../components/ProductCard.astro"
import { getCatalog, getProduct } from "../../lib/ali"
import { available, categoryPath, productIdFromParam, productPath, unpriced } from "../../lib/catalog"
import { cacheCatalog } from "../../lib/http"
import { guard, loadShell, siteOrigin } from "../../lib/site"
import { product as productLd } from "../../lib/seo"

const id = productIdFromParam(Astro.params.slug)
if (!id) return Astro.rewrite("/404")

const data = await guard(Astro, async () => {
  const shell = await loadShell(Astro)
  const [product, catalog] = await Promise.all([getProduct(id, shell.ali), getCatalog(shell.ali)])
  return { shell, product, catalog }
})
if (data instanceof Response) return data
const { shell, product: p, catalog } = data
// Producto pausado, borrado o sin publicar: Ali responde 404 y no lo lista.
// Lo decimos claro (404, nunca 500) y ofrecemos seguir comprando.
if (!p) {
  return Astro.rewrite("/producto-no-disponible")
}

// Una sola URL por producto: si el nombre cambió, redirigimos a la nueva.
const path = productPath(p)
if (decodeURIComponent(Astro.url.pathname) !== path) return Astro.redirect(path, 301)
cacheCatalog(Astro)

const { store, categories, slugs } = shell
const category = categories.find((c) => c.id === p.category_id)
const sellable = (v: (typeof p.variants)[number]) => v.available
const first = p.variants.find(sellable) ?? p.variants[0]
const { catalogOnly, contactUrl } = shell
const ask = unpriced(p)
const soldOut = !ask && !available(p)
const variantNote = (v: (typeof p.variants)[number]) => (v.available ? v.price_label : !v.buyable ? "No disponible" : "Agotado")
const single = p.variants.length === 1
const tiles = p.variants.length <= 8
const related = catalog.products.filter((x) => x.category_id === p.category_id && x.id !== p.id && available(x)).slice(0, 4)
const origin = siteOrigin(Astro.url)
const paragraphs = (p.description ?? "").split(/\n{2,}|\r\n\r\n/).map((s) => s.trim()).filter(Boolean)
const crumbs = [{ name: "Inicio", url: "/" }, ...(category ? [{ name: category.name, url: categoryPath(slugs.get(category.id)!) }] : []), { name: p.name, url: path }]
const { pickup, delivery } = store.fulfillment
const stockNote = (v: typeof first) => (v && v.available && v.stock_badge === "low" && v.stock ? `Quedan ${v.stock}` : "")
---
<Base shell={shell} title={p.name} path={path} ogType="product" ogImage={p.images[0]?.url}
  description={p.description || `${p.name}${p.price_label ? ` desde ${p.price_label}` : ""} en ${store.name}.`}
  product={{ price: first?.price, currency: first?.currency, available: available(p) }}
  crumbs={crumbs} jsonld={[productLd(p, origin, category?.name)]}>
  <div class="wrap pdp">
    <div class="product-heading">
      {category && <p class="eyebrow"><a href={categoryPath(slugs.get(category.id)!)}>{category.name}</a></p>}
      <h1>{p.name}</h1>
      <p class:list={["price-big", { muted: !available(p) }]} aria-live="polite">
        <span data-price>{first?.price_label ?? "Precio no disponible"}</span>
        {!single && first && !soldOut && <small data-variant-label>{first.name}</small>}
        <small data-stock-note>{stockNote(first)}</small>
      </p>
    </div>

    <div class="gallery">
      <div class:list={["main", { "ph empty": !p.images.length }]} data-main>
        {p.images.length ? (
          <img src={p.images[0].url} alt={p.images[0].alt || p.name} width={p.images[0].width ?? 800} height={p.images[0].height ?? 1000} fetchpriority="high" decoding="async" data-main-img />
        ) : <Icon name="photo" />}
      </div>
      {p.images.length > 1 && (
        <div class="thumbs" role="group" aria-label="Fotos del producto">
          {p.images.map((img, i) => (
            <button type="button" class="thumb" aria-label={`Ver foto ${i + 1} de ${p.images.length}`} aria-pressed={i === 0 ? "true" : "false"} data-thumb={img.url} data-alt={img.alt || p.name}>
              <img src={img.url} alt="" loading="lazy" decoding="async" width="76" height="76" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">

      {soldOut && <p class="notice warn" data-soldout><Icon name="info" /><span><strong>Agotado.</strong> {p.variants.length > 1 ? "Todas las opciones de este producto están agotadas por ahora." : "Este producto no está disponible por ahora."}</span></p>}

      <form class="buy" data-buy data-primary={p.images[0]?.url ?? ""}>
        {!single && (
          <fieldset>
            <legend>Opción</legend>
            {tiles ? (
              <div class="variant-opts">
                {p.variants.map((v) => (
                  <div class="opt">
                    <input type="radio" name="variant" id={`v-${v.id}`} value={v.id} checked={!soldOut && v.id === first?.id} disabled={!sellable(v)}
                      data-price={v.price_label ?? ""} data-label={v.name} data-image={v.image_url ?? ""} data-stock={stockNote(v)} data-max={v.max_quantity} />
                    <label for={`v-${v.id}`}><b>{v.name}</b><span>{variantNote(v)}</span></label>
                  </div>
                ))}
              </div>
            ) : (
              <select class="variant-select" name="variant" aria-label="Opción">
                {p.variants.map((v) => (
                  <option value={v.id} selected={!soldOut && v.id === first?.id} disabled={!sellable(v)}
                    data-price={v.price_label ?? ""} data-label={v.name} data-image={v.image_url ?? ""} data-stock={stockNote(v)} data-max={v.max_quantity}>
                    {v.name} · {variantNote(v)}
                  </option>
                ))}
              </select>
            )}
          </fieldset>
        )}
        {single && first && <input type="hidden" name="variant" value={first.id} data-max={first.max_quantity} />}

        {catalogOnly ? (
          contactUrl && <div class="buy-row"><a class="btn" href={contactUrl} target="_blank" rel="noopener" data-contact><Icon name="chat" /> Consultar</a></div>
        ) : ask ? (
          <div class="buy-row">{contactUrl ? <a class="btn" href={contactUrl} target="_blank" rel="noopener" data-contact><Icon name="chat" /> Consultar precio</a> : <button class="btn" type="button" disabled aria-disabled="true">Precio a consultar</button>}</div>
        ) : soldOut ? (
          <div class="buy-row"><button class="btn" type="button" disabled aria-disabled="true">Agotado</button></div>
        ) : (
          <div class="buy-row">
            <div class="qty" role="group" aria-label="Cantidad">
              <button type="button" data-step="-1" aria-label="Quitar uno">−</button>
              <input name="qty" type="number" inputmode="numeric" min="1" max={first?.max_quantity ?? 999} value="1" aria-label="Cantidad" />
              <button type="button" data-step="1" aria-label="Agregar uno">+</button>
            </div>
            <button class="btn" type="submit"><Icon name="cart" /> Agregar al carrito</button>
          </div>
        )}
        <p class="notice warn" data-error hidden role="alert"></p>
      </form>

      {paragraphs.length > 0 && <div class="description">{paragraphs.map((t) => <p>{t}</p>)}</div>}

      <dl class="kv">
        {pickup.enabled && <><dt><Icon name="store" /> Retiro</dt><dd>{pickup.address || "En la tienda"}</dd></>}
        {delivery.enabled && <><dt><Icon name="truck" /> Envío</dt><dd>{catalogOnly ? "A domicilio. Consultá el costo con la tienda." : "A domicilio. El costo se calcula con tu dirección antes de pagar."}</dd></>}
        {!catalogOnly && <><dt><Icon name="lock" /> Pago</dt><dd>En línea, en una página segura.</dd></>}
      </dl>
    </div>
  </div>

  {related.length > 0 && (
    <section class="alt">
      <div class="wrap">
        <div class="section-head"><h2>También te puede gustar</h2>{category && <a class="text-link" href={categoryPath(slugs.get(category.id)!)}>Ver {category.name.toLowerCase()} <Icon name="arrow" /></a>}</div>
        <div class="grid">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  import { addLine, problemMessage, toast, type Problem } from "../../scripts/store"

  // Galería: las miniaturas cambian la foto principal.
  const main = document.querySelector<HTMLImageElement>("[data-main-img]")
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>("[data-thumb]")]
  const show = (url: string, alt?: string) => {
    if (!main || !url) return
    main.src = url
    if (alt) main.alt = alt
    thumbs.forEach((t) => t.setAttribute("aria-pressed", String(t.dataset.thumb === url)))
  }
  thumbs.forEach((t) => t.addEventListener("click", () => show(t.dataset.thumb!, t.dataset.alt)))

  const form = document.querySelector<HTMLFormElement>("form[data-buy]")
  if (form) {
    const price = document.querySelector<HTMLElement>("[data-price]")
    const label = document.querySelector<HTMLElement>("[data-variant-label]")
    const stock = document.querySelector<HTMLElement>("[data-stock-note]")
    const qty = form.querySelector<HTMLInputElement>('input[name="qty"]')
    const error = form.querySelector<HTMLElement>("[data-error]")!
    const selected = (): HTMLElement | null =>
      form.querySelector<HTMLInputElement>('input[name="variant"]:checked') ??
      form.querySelector<HTMLSelectElement>('select[name="variant"]')?.selectedOptions[0] ?? null

    // El precio grande es SIEMPRE el de la opción elegida (viene formateado por Ali).
    const refresh = () => {
      const v = selected() ?? form.querySelector<HTMLElement>('input[type="hidden"][name="variant"]')
      if (!v) return
      if (price && v.dataset.price) price.textContent = v.dataset.price
      if (label) label.textContent = v.dataset.label ?? ""
      if (stock) stock.textContent = v.dataset.stock ?? ""
      if (qty && v.dataset.max) {
        qty.max = v.dataset.max
        if (Number(qty.value) > Number(v.dataset.max)) qty.value = v.dataset.max
      }
      // Sólo cambiamos la foto si la opción tiene una propia (distinta de la principal).
      if (v.dataset.image && v.dataset.image !== form.dataset.primary) show(v.dataset.image)
    }
    form.addEventListener("change", refresh)
    refresh()

    form.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) => b.addEventListener("click", () => {
      if (!qty) return
      qty.value = String(Math.min(Number(qty.max) || 999, Math.max(1, Number(qty.value || 1) + Number(b.dataset.step))))
    }))

    let soldOutNow = false
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      const v = selected()
      const variantId = (v as HTMLInputElement | HTMLOptionElement | null)?.value || form.querySelector<HTMLInputElement>('input[type="hidden"][name="variant"]')?.value
      if (!variantId) return
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
      error.hidden = true
      button.disabled = true
      button.classList.add("loading")
      try {
        const quantity = Math.max(1, Number(qty?.value || 1))
        const cart = await addLine(variantId, quantity)
        const issue = cart.issues.find((i) => i.code === "reduced")
        toast(issue ? "Agregado, pero ajustamos la cantidad a lo disponible." : quantity > 1 ? `Agregaste ${quantity} al carrito.` : "Agregado al carrito.")
      } catch (error_) {
        const problem = error_ as Problem
        // 409 out-of-stock: se agotó mientras mirabas. Lo marcamos y no dejamos reintentar.
        // Ali manda el type con guion (store_api_controller.ex, mutate_cart/2).
        if (problem.status === 409 && /out[-_]of[-_]stock$/.test(problem.type ?? "")) {
          const input = v as HTMLInputElement | HTMLOptionElement | null
          if (input && "disabled" in input) input.disabled = true
          const label = input instanceof HTMLInputElement ? form.querySelector(`label[for="${input.id}"] span`) : null
          if (label) label.textContent = "Agotado"
          if (input instanceof HTMLOptionElement) input.textContent = `${input.dataset.label} · Agotado`
          const left = form.querySelectorAll('input[name="variant"]:not([disabled]):not([type="hidden"]), select[name="variant"] option:not([disabled])').length
          error.textContent = left ? "Esta opción se acaba de agotar. Elegí otra." : "Este producto se acaba de agotar."
          if (!left) { soldOutNow = true; button.textContent = "Agotado" }
          else (form.querySelector<HTMLInputElement>('input[name="variant"]:not([disabled])') ?? null)?.click()
        } else {
          error.textContent = problemMessage(problem)
        }
        error.hidden = false
        error.scrollIntoView({ behavior: "smooth", block: "center" })
      } finally {
        button.disabled = soldOutNow
        button.classList.remove("loading")
      }
    })
  }
</script>
